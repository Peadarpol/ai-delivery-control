+        count = conn.execute(
+            "SELECT COUNT(*) FROM sessions WHERE session_id = 'upsert-test';"
+        ).fetchone()[0]
+        outcome = conn.execute(
+            "SELECT outcome FROM sessions WHERE session_id = 'upsert-test';"
+        ).fetchone()[0]
